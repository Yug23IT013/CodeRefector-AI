# ===================================================
# Backend — Python / FastAPI .gitignore
# ===================================================

# ----- Secrets & Environment -----
.env
.env.local
.env.*.local
*.env
!.env.example

# ----- Database Files -----
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-shm
*.db-wal
coderefactor.db

# ----- Python Bytecode & Cache -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ----- Virtual Environments -----
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ----- Build & Distribution -----
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ----- Testing & Coverage -----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
junit.xml

# ----- Logs & Temp -----
*.log
logs/
*.tmp
*.temp
*.pid

# ----- Alembic -----
# Keep migration scripts but ignore generated temp files
alembic/versions/__pycache__/

# ----- OS & Editor -----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.history/
