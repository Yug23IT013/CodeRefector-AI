# ===================================================
# CodeRefactor AI Environment Configuration
# ===================================================

# Environment mode: development | staging | production
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database URL
# For local dev without Docker, SQLite fallback is used automatically if blank or sqlite:///./coderefactor.db
# For PostgreSQL with Docker: postgresql://postgres:postgres@localhost:5432/coderefactor
DATABASE_URL=sqlite:///./coderefactor.db

# GitHub Webhook Configuration
# Secret configured in your GitHub Repo / Organization Webhook settings
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# GitHub Authentication for fetching PR diffs and posting review comments
# Use a Personal Access Token (classic with repo scope, or fine-grained with Pull Requests: Read & Write)
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# AI Configuration: Groq Cloud (Free Tier)
# Get your completely free API key instantly at: https://console.groq.com/keys
# Supported models: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_API_KEY=gsk_your_free_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Dashboard & JWT Security
DASHBOARD_API_TOKEN=
JWT_SECRET=coderefactor-jwt-secret-key-development
FRONTEND_URL=http://localhost:5173

# GitHub OAuth Login (Optional: Register at GitHub -> Settings -> Developer Settings -> OAuth Apps)
# Homepage URL: http://localhost:5173
# Authorization callback URL: http://localhost:8000/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public Webhook URL for Automated Webhook Installation (e.g. Smee or ngrok URL)
WEBHOOK_PUBLIC_URL=https://smee.io/your-channel-id
