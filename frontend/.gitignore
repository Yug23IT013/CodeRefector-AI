coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ----- Logs -----
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Cache -----
.cache/
.eslintcache
.stylelintcache
.parcel-cache/

